HOST=127.0.0.1
PORT=5050
NODE_ENV=development
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=michoks
PGUSER=postgres
PGPASSWORD=
# Alternativa: DATABASE_URL=postgresql://usuario:clave@host:5432/base
# Vacío permite únicamente el mismo origen. Para otro cliente, indica su URL exacta.
CLIENT_ORIGIN=
# Solo conexiones TLS con certificado verificable cuando PGSSL=true.
PGSSL=false
SESSION_HOURS=24

# Secreto aleatorio de al menos 32 caracteres para firmar JWT.
JWT_SECRET=
