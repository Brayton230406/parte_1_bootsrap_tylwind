{
  "info": {
    "name": "MICHOKS - API REST",
    "description": "Importar en Thunder Client o Postman. Usa tokens de prueba y nunca publiques credenciales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5050/api/v1"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/salud"
      }
    },
    {
      "name": "Catálogo de diez productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/productos?limit=10&offset=0"
      }
    },
    {
      "name": "Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"admin_michoks\",\n  \"password\": \"REEMPLAZAR_EN_LOCAL\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Administración sin sesión: 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/esquema"
      }
    },
    {
      "name": "Esquemas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/esquema"
      }
    },
    {
      "name": "Esquema de producto",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/esquema/producto"
      }
    },
    {
      "name": "Productos administrativos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/producto?limit=10&offset=0"
      }
    },
    {
      "name": "Producto por clave",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/producto/registro?id_producto=1"
      }
    },
    {
      "name": "Mis pedidos: token de cliente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/pedidos"
      }
    }
  ]
}
