    },
    {
      "name": "MICHOKS Backend",
      "path": "server"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "MICHOKS: iniciar backend",
        "type": "shell",
        "command": "npm run dev",
