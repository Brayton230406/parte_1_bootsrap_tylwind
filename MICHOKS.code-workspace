        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated"
        }
      },
      {
        "label": "MICHOKS: iniciar frontend",
        "type": "shell",
        "command": "npm run dev",
        "options": {
          "cwd": "${workspaceFolder:MICHOKS Frontend}"
        },
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated"
        }
      },
      {
        "label": "MICHOKS: iniciar ambos",
        "dependsOn": [
          "MICHOKS: iniciar backend",
          "MICHOKS: iniciar frontend"
        ],
        "dependsOrder": "parallel",
        "problemMatcher": []
      }
    ]
  }
